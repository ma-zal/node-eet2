{
  "name": "eet2-core",
  "version": "0.1.0",
  "description": "Klient pro EET 2.0 (elektronická evidence tržeb v ČR): podpis a odeslání datové zprávy o tržbě, pokladní certifikát.",
  "license": "MIT",
  "author": "Martin Zaloudek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ma-zal/node-eet2.git",
    "directory": "packages/core"
  },
  "keywords": ["eet", "eet2", "evidence tržeb", "fiscalization", "czech"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "certs",
    "schema"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:playground": "vitest run --dir test/playground"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.2",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14"
  }
}
