{
  "name": "node-eet2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --tsconfig packages/signing-service/tsconfig.json packages/signing-service/src/server.ts",
    "start": "node packages/signing-service/dist/server.js",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:playground": "node scripts/download-playground-fixtures.mjs && npm run test:playground --workspaces --if-present"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
